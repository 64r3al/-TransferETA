{
  "name": "transfereta",
  "version": "1.0.0",
  "private": false,
  "description": "A precise, lightweight, privacy-first upload time calculator.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.1.0"
  }
}
